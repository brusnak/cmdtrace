def get_event_file(session: str) -> Path:
    safe = re.sub(r'[^A-Za-z0-9_.-]', '_', session)
    return FS_EVENT_DIR / f"cmdtrace_events_{safe}.jsonl"

def _fs_event_state(path: str) -> dict:
    try:
        st = os.stat(path)
        return {"mode": oct(st.st_mode & 0o7777), "uid": st.st_uid, "gid": st.st_gid, "size": st.st_size}
    except (FileNotFoundError, PermissionError, OSError):
        return {}

def _fs_event_ignored(path: str, name: str, patterns: list) -> bool:
    return any(fnmatch.fnmatch(path, pat) or fnmatch.fnmatch(name, pat) for pat in patterns)

def _inotify_init():
    libc = ctypes.CDLL(None, use_errno=True)
    init1 = getattr(libc, "inotify_init1", None)
    if init1 is not None:
        init1.argtypes = [ctypes.c_int]
        init1.restype = ctypes.c_int
        fd = init1(IN_NONBLOCK)
    else:
        init = libc.inotify_init
        init.argtypes = []
        init.restype = ctypes.c_int
        fd = init()
        if fd >= 0:
            os.set_blocking(fd, False)
    if fd < 0:
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err))
    return libc, fd

def _inotify_add_watch(libc, fd: int, path: str) -> int:
    add_watch = libc.inotify_add_watch
    add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
    add_watch.restype = ctypes.c_int
    mask = IN_CREATE | IN_DELETE | IN_ATTRIB | IN_CLOSE_WRITE | IN_MOVED_FROM | IN_MOVED_TO | IN_DELETE_SELF | IN_MOVE_SELF
    wd = add_watch(fd, os.fsencode(path), mask)
    if wd < 0:
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err))
    return wd

def _inotify_remove_watch(libc, fd: int, wd: int) -> None:
    try:
        rm_watch = libc.inotify_rm_watch
        rm_watch.argtypes = [ctypes.c_int, ctypes.c_int]
        rm_watch.restype = ctypes.c_int
        rm_watch(fd, wd)
    except Exception:
        pass

def _write_fs_event(fp, event: dict) -> None:
    fp.write(json.dumps(event, separators=(",", ":")) + "\n")
    fp.flush()

def _run_inotify_collector(event_file: Path) -> int:
    stop_requested = False
    def request_stop(signum, frame):
        nonlocal stop_requested
        stop_requested = True
    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)

    event_file.parent.mkdir(parents=True, exist_ok=True)
    watch_dirs = load_watch_dirs()
    ignore_patterns = load_ignore_patterns()
    try:
        libc, fd = _inotify_init()
    except Exception as e:
        print(f"Filesystem event monitor unavailable: {e}", file=sys.stderr)
        return 1

    watches, pending_moves, state_cache = {}, {}, {}
    try:
        with open(event_file, "a", buffering=1) as out:
            for target in watch_dirs:
                if not os.path.isdir(target):
                    continue
                for root, dirs, _ in os.walk(target):
                    if _fs_event_ignored(root, os.path.basename(root), ignore_patterns):
                        dirs[:] = []
                        continue
                    try:
                        wd = _inotify_add_watch(libc, fd, root)
                        watches[wd] = root
                    except OSError:
                        continue
            _write_fs_event(out, {"timestamp": time.time(), "event": "MONITOR_STARTED", "path": None})

            while not stop_requested:
                try:
                    data = os.read(fd, 1024 * 64)
                except BlockingIOError:
                    time.sleep(0.10)
                    continue
                except OSError as e:
                    if e.errno == errno.EINTR:
                        continue
                    break
                offset = 0
                while offset + INOTIFY_EVENT_STRUCT.size <= len(data):
                    wd, mask, cookie, name_len = INOTIFY_EVENT_STRUCT.unpack_from(data, offset)
                    offset += INOTIFY_EVENT_STRUCT.size
                    raw_name = data[offset:offset + name_len]
                    offset += name_len
                    name = raw_name.split(b"\0", 1)[0].decode(errors="replace")
                    if mask & IN_Q_OVERFLOW:
                        _write_fs_event(out, {"timestamp": time.time(), "event": "QUEUE_OVERFLOW", "path": None, "warning": "inotify queue overflow; some filesystem events may be missing"})
                        continue
                    parent = watches.get(wd)
                    if not parent:
                        continue
                    path = os.path.join(parent, name) if name else parent
                    if _fs_event_ignored(path, name, ignore_patterns):
                        continue
                    is_dir = bool(mask & IN_ISDIR)
                    state_now = _fs_event_state(path) if not (mask & IN_DELETE) else {}
                    previous = state_cache.get(path, {})

                    if (mask & (IN_CREATE | IN_MOVED_TO)) and is_dir and os.path.isdir(path):
                        try:
                            new_wd = _inotify_add_watch(libc, fd, path)
                            watches[new_wd] = path
                        except OSError:
                            pass

                    emitted = []
                    if mask & IN_CREATE:
                        emitted.append(("CREATED", {"state": state_now}))
                        state_cache[path] = state_now

                    if mask & IN_DELETE:
                        emitted.append(("DELETED", {}))
                        state_cache.pop(path, None)

                    if mask & IN_MOVED_FROM:
                        pending_moves[cookie] = {"path": path, "state": previous}
                        emitted.append(("MOVED_FROM", {}))
                        state_cache.pop(path, None)

                    if mask & IN_MOVED_TO:
                        details = {"state": state_now}
                        moved = pending_moves.pop(cookie, None)
                        if moved:
                            details["from"] = moved["path"]
                            details["state_before"] = moved.get("state", {})
                        emitted.append(("MOVED_TO", details))
                        state_cache[path] = state_now

                    if mask & IN_ATTRIB:
                        changes = {}
                        if previous and state_now:
                            for field in ("mode", "uid", "gid"):
                                if previous.get(field) != state_now.get(field):
                                    changes[field] = {"before": previous.get(field), "after": state_now.get(field)}
                        metadata_event = "METADATA_CHANGED"
                        if "mode" in changes:
                            metadata_event = "PERMISSIONS_CHANGED"
                        elif "uid" in changes or "gid" in changes:
                            metadata_event = "OWNERSHIP_CHANGED"
                        emitted.append((metadata_event, {"changes": changes, "state": state_now}))
                        state_cache[path] = state_now

                    if mask & IN_CLOSE_WRITE:
                        emitted.append(("CONTENT_WRITE", {"state": state_now}))
                        state_cache[path] = state_now

                    for event_name, details in emitted:
                        _write_fs_event(out, {"timestamp": time.time(), "event": event_name, "path": path, "is_dir": is_dir, "cookie": cookie, **details})

                    if mask & (IN_DELETE_SELF | IN_MOVE_SELF | IN_IGNORED):
                        watches.pop(wd, None)
    finally:
        for wd in list(watches):
            _inotify_remove_watch(libc, fd, wd)
        try:
            os.close(fd)
        except OSError:
            pass
    return 0

class EventCollector(ABC):
    """Interface between cmdtrace and a live event collection backend.

    The rest of cmdtrace only depends on this contract. A future native
    collector can implement the same lifecycle while the reporting and
    detector layers remain unchanged.
    """

    name = "abstract"
    description = "Abstract event collector"

    @abstractmethod
    def start(self, session: str) -> dict:
        """Start collection and return persistent session metadata."""
        raise NotImplementedError

    @abstractmethod
    def stop(self, metadata: dict) -> list:
        """Stop collection and return normalized event dictionaries."""
        raise NotImplementedError


class SubprocessEventCollector(EventCollector):
    """Common lifecycle for collectors that run as detached helper processes."""

    ready_event = "MONITOR_STARTED"

    def _command(self, session: str, event_file: Path) -> list:
        raise NotImplementedError

    def start(self, session: str) -> dict:
        event_file = get_event_file(session)
        try:
            event_file.unlink()
        except FileNotFoundError:
            pass

        cmd = self._command(session, event_file)
        try:
            with open(os.devnull, "w") as devnull:
                proc = subprocess.Popen(
                    cmd,
                    stdin=subprocess.DEVNULL,
                    stdout=devnull,
                    stderr=devnull,
                    start_new_session=True,
                    close_fds=True,
                )

            # cmdtrace start does not return until the collector has installed
            # its watches and emitted its readiness marker. This prevents the
            # caller from immediately changing a file in a startup race.
            ready_deadline = time.time() + 3.0
            ready = False
            while time.time() < ready_deadline:
                if proc.poll() is not None:
                    break
                try:
                    if event_file.exists():
                        with open(event_file, "r") as f:
                            if any(f'"event":"{self.ready_event}"' in line for line in f):
                                ready = True
                                break
                except OSError:
                    pass
                time.sleep(0.05)

            if not ready:
                try:
                    proc.terminate()
                except Exception:
                    pass
                raise RuntimeError(f"{self.name} did not become ready")

            meta = {
                "backend": self.name,
                "pid": proc.pid,
                "event_file": str(event_file),
            }
            if isinstance(self, NativeEventCollector):
                meta["executable"] = self.executable
            return meta
        except Exception as e:
            print(f"Warning: could not start {self.name}: {e}", file=sys.stderr)
            return {}

    def stop(self, metadata: dict) -> list:
        pid = metadata.get("pid")
        event_file = Path(metadata.get("event_file", "")) if metadata.get("event_file") else None

        if pid:
            try:
                os.kill(int(pid), signal.SIGTERM)
            except ProcessLookupError:
                pass
            except Exception as e:
                print(f"Warning: could not stop collector PID {pid}: {e}", file=sys.stderr)

            deadline = time.time() + 3.0
            while time.time() < deadline:
                try:
                    os.kill(int(pid), 0)
                    time.sleep(0.05)
                except (ProcessLookupError, PermissionError):
                    break
                except Exception:
                    break

        events = []
        if event_file and event_file.exists():
            try:
                with open(event_file, "r") as f:
                    for line in f:
                        try:
                            event = json.loads(line)
                            if event.get("event") != self.ready_event:
                                events.append(event)
                        except json.JSONDecodeError:
                            continue
            except Exception as e:
                print(f"Warning: could not read collector event log: {e}", file=sys.stderr)
            try:
                event_file.unlink()
            except Exception:
                pass
        return events


class PythonInotifyCollector(SubprocessEventCollector):
    """Current collector backend: native Linux inotify accessed from Python ctypes."""

    name = "python-inotify"
    description = "Python ctypes wrapper around the Linux inotify API"

    def _command(self, session: str, event_file: Path) -> list:
        script_path = str(Path(__file__).resolve())
        return [
            sys.executable,
            script_path,
            "_collector",
            "--backend",
            self.name,
            "--session",
            session,
            "--event-file",
            str(event_file),
        ]


class NativeEventCollector(SubprocessEventCollector):
    """Future native backend using an external collector executable.

    The native program only needs to honor the cmdtrace event-file protocol:
    write JSONL events, emit MONITOR_STARTED after initialization, and exit on
    SIGTERM. This keeps the eventual C/C++/Rust collector independent of the
    Python application.
    """

    name = "native"
    description = "External native Linux event collector"

    def __init__(self, executable: str):
        self.executable = executable

    def _command(self, session: str, event_file: Path) -> list:
        return [
            self.executable,
            "--session",
            session,
            "--event-file",
            str(event_file),
        ]


def get_event_collector() -> EventCollector:
    """Select the event backend without coupling the application to its implementation."""
    configured = load_config().get("event_collector", DEFAULT_EVENT_COLLECTOR)
    native_executable = load_config().get("native_collector") or os.environ.get(NATIVE_COLLECTOR_ENV)

    if configured == "native":
        if not native_executable:
            raise RuntimeError(
                "event_collector is 'native' but no native collector executable is configured; "
                f"set '{NATIVE_COLLECTOR_ENV}' or add 'native_collector' to {CONFIG_FILE}"
            )
        return NativeEventCollector(native_executable)

    if configured != DEFAULT_EVENT_COLLECTOR:
        raise RuntimeError(f"Unsupported event collector backend: {configured}")

    return PythonInotifyCollector()


def start_event_collector(session: str) -> dict:
    """Start the configured collector and return session metadata."""
    try:
        return get_event_collector().start(session)
    except Exception as e:
        print(f"Warning: event collector unavailable: {e}", file=sys.stderr)
        return {}


def stop_event_collector(metadata: dict) -> list:
    """Stop the collector recorded in session metadata and return its events."""
    backend = metadata.get("backend", DEFAULT_EVENT_COLLECTOR)
    if backend == "native":
        executable = metadata.get("executable") or load_config().get("native_collector") or os.environ.get(NATIVE_COLLECTOR_ENV)
        if not executable:
            print("Warning: native collector executable is no longer configured", file=sys.stderr)
            return []
        collector = NativeEventCollector(executable)
    else:
        collector = PythonInotifyCollector()
    return collector.stop(metadata)


def render_filesystem_activity(events: list) -> None:
    if not events:
        return
    print("FILESYSTEM ACTIVITY TIMELINE")
    for event in events[:200]:
        ts = datetime.fromtimestamp(event.get("timestamp", time.time())).strftime("%H:%M:%S")
        kind = event.get("event", "UNKNOWN")
        path = event.get("path") or "—"
        if kind in ("METADATA_CHANGED", "PERMISSIONS_CHANGED", "OWNERSHIP_CHANGED"):
            changes = event.get("changes", {})
            if changes.get("mode"):
                detail = f"mode {changes['mode']['before']} → {changes['mode']['after']}"
            elif changes.get("uid") or changes.get("gid"):
                detail = ", ".join(f"{field} {change['before']} → {change['after']}" for field, change in changes.items())
            else:
                detail = "metadata/attributes changed"
        elif kind == "MOVED_TO" and event.get("from"):
            detail = f"from {event['from']}"
        elif kind == "CREATED":
            state = event.get("state", {})
            detail = f"mode={state.get('mode', '?')} uid={state.get('uid', '?')} gid={state.get('gid', '?')}"
        else:
            detail = ""
        suffix = f" — {detail}" if detail else ""
        print(f"  {ts}  {kind:<18} {path}{suffix}")
    if len(events) > 200:
        print(f"  ... and {len(events) - 200} additional filesystem events")
    print()

def filesystem_activity_metrics(events: list) -> dict:
    return {"Filesystem Events": len(events)}

