class UsersAuthDetector(BaseDetector):
    name = "Users, Groups & Auth"
    description = "Tracks /etc/passwd, /etc/group, sudoers, SSH keys, and sshd_config"

    def collect(self) -> dict:
        users, groups, ssh_keys = {}, {}, {}
        if Path("/etc/passwd").exists():
            try:
                with open("/etc/passwd", "r") as f:
                    for line in f:
                        p = line.strip().split(":")
                        if len(p) >= 7:
                            users[p[0]] = {"uid": p[2], "gid": p[3], "home": p[5], "shell": p[6]}
            except Exception:
                pass

        if Path("/etc/group").exists():
            try:
                with open("/etc/group", "r") as f:
                    for line in f:
                        p = line.strip().split(":")
                        if len(p) >= 4:
                            groups[p[0]] = {"gid": p[2], "members": p[3].split(",") if p[3] else []}
            except Exception:
                pass

        for user, data in users.items():
            auth_file = Path(data["home"]) / ".ssh" / "authorized_keys"
            if auth_file.exists():
                ssh_keys[user] = hash_file(auth_file)

        pam_hashes = {}
        pam_dir = Path("/etc/pam.d")
        if pam_dir.is_dir():
            try:
                for f in sorted(pam_dir.glob("*")):
                    if f.is_file():
                        pam_hashes[str(f)] = hash_file(f)
            except Exception:
                pass

        return {
            "users": users,
            "groups": groups,
            "ssh_keys": ssh_keys,
            "sudoers_hash": hash_file(Path("/etc/sudoers")),
            "sshd_hash": hash_file(Path("/etc/ssh/sshd_config")),
            "shadow_hash": hash_file(Path("/etc/shadow")),
            "pam_hashes": pam_hashes
        }

    def diff(self, start: dict, stop: dict, meta_start: dict, meta_stop: dict) -> dict:
        users_a, users_b = start.get("users", {}), stop.get("users", {})
        groups_a, groups_b = start.get("groups", {}), stop.get("groups", {})
        ssh_a, ssh_b = start.get("ssh_keys", {}), stop.get("ssh_keys", {})
        pam_a, pam_b = start.get("pam_hashes", {}), stop.get("pam_hashes", {})

        return {
            "users_added": sorted(u for u in users_b if u not in users_a),
            "users_removed": sorted(u for u in users_a if u not in users_b),
            "groups_added": sorted(g for g in groups_b if g not in groups_a),
            "groups_removed": sorted(g for g in groups_a if g not in groups_b),
            "ssh_keys_changed": sorted(
                u for u in set(ssh_a) | set(ssh_b) if ssh_a.get(u) != ssh_b.get(u)
            ),
            "sudoers_changed": start.get("sudoers_hash") != stop.get("sudoers_hash"),
            "sshd_changed": start.get("sshd_hash") != stop.get("sshd_hash"),
            "shadow_changed": start.get("shadow_hash") != stop.get("shadow_hash"),
            "pam_changed_files": sorted(
                f for f in set(pam_a) | set(pam_b) if pam_a.get(f) != pam_b.get(f)
            )
        }

    def render(self, diff_data: dict) -> None:
        if any(diff_data.values()):
            print("USER, GROUP & SECURITY CONFIGURATION")
            for u in diff_data["users_added"]:
                print(f"  + User created: {u}")
            for u in diff_data["users_removed"]:
                print(f"  - User deleted: {u}")
            for g in diff_data["groups_added"]:
                print(f"  + Group created: {g}")
            for g in diff_data["groups_removed"]:
                print(f"  - Group deleted: {g}")
            for u in diff_data["ssh_keys_changed"]:
                print(f"  ! ALERT: SSH authorized_keys changed for user: {u}")
            if diff_data["sudoers_changed"]:
                print("  ! ALERT: /etc/sudoers file was modified")
            if diff_data["sshd_changed"]:
                print("  ! ALERT: /etc/ssh/sshd_config file was modified")
            if diff_data["shadow_changed"]:
                print("  ! ALERT: /etc/shadow file was modified")
            if diff_data["pam_changed_files"]:
                print(f"  ! ALERT: PAM configuration modified ({len(diff_data['pam_changed_files'])} file(s))")
                for f in diff_data["pam_changed_files"][:5]:
                    print(f"      - {f}")
            print()

    def summary_metrics(self, diff_data: dict) -> dict:
        return {
            "Users Created": len(diff_data.get("users_added", [])),
            "Users Removed": len(diff_data.get("users_removed", [])),
            "Groups Changed": len(diff_data.get("groups_added", [])) + len(diff_data.get("groups_removed", [])),
            "SSH Key Changes": len(diff_data.get("ssh_keys_changed", []))
        }


