SNAPSHOT_FILE = Path("/var/tmp/cmdtrace_snapshot.json")
CONFIG_FILE = Path("/etc/cmdtrace_config.json")
BASELINE_DIR = Path("/var/lib/cmdtrace/baselines")
HISTORY_LOG_FILE = Path("/var/log/cmdtrace/history.log")

DEFAULT_WATCH_DIRS = [
    "/etc",
    "/usr/local/bin",
    "/usr/local/sbin",
    "/usr/local/etc",
    "/opt",
    "/root",
    "/boot",
    "/usr/lib/systemd/system",
    "/var/www"
]

# Glob-style patterns (matched against the full path and against the bare
# filename) that the Filesystem Integrity Watcher skips over. Keeps expected,
# high-churn noise (VCS internals, caches, logs) out of every report.
DEFAULT_IGNORE_PATTERNS = [
    "*.log",
    "*.tmp",
    "*.swp",
    "*/.git/*",
    "*/__pycache__/*",
    "*/node_modules/*",
]

# Environment variable NAMES matching this pattern have their VALUE redacted
# before ever being written to a snapshot, report, or export file.
SENSITIVE_ENV_NAME_PATTERN = re.compile(
    r"(KEY|TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL|AUTH|PRIVATE)", re.IGNORECASE
)

HASH_MAX_SIZE_BYTES = 1024 * 512  # 512 KB threshold for full SHA256 hashing

FS_EVENT_DIR = Path("/var/tmp")
INOTIFY_EVENT_STRUCT = struct.Struct("iIII")
IN_CREATE = 0x00000100
IN_DELETE = 0x00000200
IN_ATTRIB = 0x00000004
IN_CLOSE_WRITE = 0x00000008
IN_MOVED_FROM = 0x00000040
IN_MOVED_TO = 0x00000080
IN_DELETE_SELF = 0x00000400
IN_MOVE_SELF = 0x00000800
IN_ISDIR = 0x40000000
IN_IGNORED = 0x00008000
IN_Q_OVERFLOW = 0x00004000
IN_NONBLOCK = 0x00000800

# Event collector architecture. The application talks to an abstract collector
# interface so the event source can later move from Python/inotify to a native
# Linux collector without changing cmdtrace's session, reporting, or CLI layers.
DEFAULT_EVENT_COLLECTOR = "python-inotify"
NATIVE_COLLECTOR_ENV = "CMDTRACE_NATIVE_COLLECTOR"

# Detector modules are intentionally split into two tiers:
#   1. Built-in detectors defined in this file (always loaded first).
#   2. Optional external detector modules loaded from the configured path.
# The external modules use the same BaseDetector contract as built-ins.
DEFAULT_MODULE_PATH = "/etc/cmdtrace/modules"
MODULE_PATH_CONFIG_KEY = "module_path"
_EXTERNAL_MODULES_LOADED = False
_EXTERNAL_MODULE_FILES = []
_EXTERNAL_MODULE_ERRORS = []


def load_config() -> dict:
    """Load the full persistent config (watch dirs + ignore patterns), falling back to defaults."""
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE, "r") as f:
                data = json.load(f)
            data.setdefault("watch_dirs", list(DEFAULT_WATCH_DIRS))
            data.setdefault("ignore_patterns", list(DEFAULT_IGNORE_PATTERNS))
            return data
        except Exception:
            pass
    return {"watch_dirs": list(DEFAULT_WATCH_DIRS), "ignore_patterns": list(DEFAULT_IGNORE_PATTERNS)}


def save_config(data: dict) -> bool:
    """Persist the full config dict to disk."""
    try:
        CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
        with open(CONFIG_FILE, "w") as f:
            json.dump(data, f, indent=2)
        return True
    except Exception as e:
        print(f"Error saving configuration: {e}", file=sys.stderr)
        return False


def load_watch_dirs() -> list:
    """Load persistent watch directories from config file, falling back to defaults."""
    return sorted(set(load_config().get("watch_dirs", DEFAULT_WATCH_DIRS)))


def save_watch_dirs(dirs: list) -> bool:
    """Save watch directory list persistently to disk."""
    cfg = load_config()
    cfg["watch_dirs"] = sorted(set(dirs))
    return save_config(cfg)


def load_ignore_patterns() -> list:
    """Load persistent filesystem-watcher ignore patterns, falling back to defaults."""
    return sorted(set(load_config().get("ignore_patterns", DEFAULT_IGNORE_PATTERNS)))


def save_ignore_patterns(patterns: list) -> bool:
    """Save the ignore-pattern list persistently to disk."""
    cfg = load_config()
    cfg["ignore_patterns"] = sorted(set(patterns))
    return save_config(cfg)


def load_module_path() -> Optional[Path]:
    """Return the configured external detector-module directory, if one is set."""
    configured = load_config().get(MODULE_PATH_CONFIG_KEY)
    if not configured:
        return None
    return Path(configured).expanduser().resolve()


def save_module_path(path_str: str) -> bool:
    """Persist the external detector-module directory."""
    path = Path(path_str).expanduser().resolve()
    cfg = load_config()
    cfg[MODULE_PATH_CONFIG_KEY] = str(path)
    return save_config(cfg)


def redact_env(env: dict) -> dict:
    """
    Return a copy of an environment dict with sensitive-looking values
    replaced by a short SHA-256 fingerprint of the value, rather than a
    fixed placeholder string. A fixed placeholder ("***REDACTED***") would
    be identical across two snapshots even if the underlying secret changed,
    making a rotated key/password invisible to the diff. Fingerprinting
    keeps the actual value out of the snapshot entirely (SHA-256 is one-way)
    while still letting two snapshots be compared to detect that it changed.
    """
    redacted = {}
    for k, v in env.items():
        if SENSITIVE_ENV_NAME_PATTERN.search(k):
            fingerprint = hashlib.sha256(str(v).encode("utf-8", errors="replace")).hexdigest()[:12]
            redacted[k] = f"***REDACTED(sha256:{fingerprint})***"
        else:
            redacted[k] = v
    return redacted


