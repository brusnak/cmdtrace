def run_cmd(cmd: list) -> str:
    """Execute system command safely and return stdout string."""
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        return res.stdout.strip() if res.returncode == 0 else ""
    except Exception:
        return ""


def hash_file(path: Path) -> str:
    """Generate SHA256 hash for a given file path."""
    try:
        if path.is_file() and path.stat().st_size <= HASH_MAX_SIZE_BYTES:
            with open(path, "rb") as f:
                return hashlib.sha256(f.read()).hexdigest()
    except Exception:
        pass
    return ""


def mode_has_suid_sgid(mode_str: str) -> bool:
    """Return True if an octal mode string (e.g. '0o4755') has the setuid or setgid bit set."""
    try:
        return bool(int(mode_str, 8) & 0o6000)
    except Exception:
        return False


