class PackageDetector(BaseDetector):
    name = "Software Packages"
    description = "Tracks installed, removed, and updated software packages via dpkg or rpm"

    def collect(self) -> dict:
        packages = {}

        # 1. Debian / Ubuntu (dpkg / apt)
        if Path("/usr/bin/dpkg-query").exists():
            # Query format: Package:Arch <tab> Version <tab> Status
            out = run_cmd(["dpkg-query", "-W", "-f=${Package}:${Architecture}\t${Version}\t${db:Status-Status}\n"])
            for line in out.splitlines():
                parts = line.split("\t")
                if len(parts) == 3 and parts[2] == "installed":
                    pkg_key, ver = parts[0], parts[1]
                    packages[pkg_key] = ver

        # 2. RHEL / Fedora / CentOS / Rocky (rpm / dnf)
        elif Path("/usr/bin/rpm").exists():
            # Query format: Name.Arch <tab> Epoch:Version-Release
            out = run_cmd(["rpm", "-qa", "--qf", "%{NAME}.%{ARCH}\t%{EPOCHNUM}:%{VERSION}-%{RELEASE}\n"])
            for line in out.splitlines():
                if "\t" in line:
                    pkg_key, ver = line.split("\t", 1)
                    # Clean up zero epoch prefixes for readability (e.g., "0:1.2" -> "1.2")
                    if ver.startswith("0:"):
                        ver = ver[2:]
                    packages[pkg_key] = ver

        return packages

    def diff(self, start: dict, stop: dict, meta_start: dict, meta_stop: dict) -> dict:
        added = {}
        removed = {}
        updated = {}

        all_keys = set(start.keys()) | set(stop.keys())

        for key in all_keys:
            in_start = key in start
            in_stop = key in stop

            if in_stop and not in_start:
                added[key] = stop[key]
            elif in_start and not in_stop:
                removed[key] = start[key]
            elif start[key] != stop[key]:
                updated[key] = {
                    "old": start[key],
                    "new": stop[key]
                }

        return {
            "added": added,
            "removed": removed,
            "updated": updated
        }

    def render(self, diff_data: dict) -> None:
        added = diff_data.get("added", {})
        removed = diff_data.get("removed", {})
        updated = diff_data.get("updated", {})

        if added or removed or updated:
            print("PACKAGES & SOFTWARE")
            for p, v in added.items():
                print(f"  + Package Installed: {p} ({v})")
            for p, info in updated.items():
                print(f"  ~ Package Updated:   {p} ({info['old']} → {info['new']})")
            for p in removed:
                print(f"  - Package Removed:   {p}")
            print()

    def summary_metrics(self, diff_data: dict) -> dict:
        return {
            "Packages Installed": len(diff_data.get("added", {})),
            "Packages Updated": len(diff_data.get("updated", {})),
            "Packages Removed": len(diff_data.get("removed", {}))
        }


class ServiceDepsDetector(BaseDetector):
    name = "Systemd Services & Deps"
    description = "Tracks systemd service unit states and dependency trees"

    def collect(self) -> dict:
        services = {}
        out = run_cmd(["systemctl", "list-unit-files", "--type=service", "--no-legend", "--no-pager"])
        for line in out.splitlines():
            parts = line.split()
            if len(parts) >= 2:
                services[parts[0]] = {"enabled": parts[1], "active": "unknown"}

        out_act = run_cmd(["systemctl", "list-units", "--type=service", "--all", "--no-legend", "--no-pager"])
        for line in out_act.splitlines():
            parts = line.split()
            if len(parts) >= 4 and parts[0] in services:
                services[parts[0]]["active"] = parts[2]

        return {"services": services}

    def diff(self, start: dict, stop: dict, meta_start: dict, meta_stop: dict) -> dict:
        srv_a = start.get("services", {})
        srv_b = stop.get("services", {})
        added, changed = {}, {}

        for name, info_b in srv_b.items():
            if name not in srv_a:
                added[name] = info_b
            elif srv_a[name] != info_b:
                changed[name] = {"before": srv_a[name], "after": info_b}
        return {"added": added, "changed": changed}

    def render(self, diff_data: dict) -> None:
        if diff_data["added"] or diff_data["changed"]:
            print("SYSTEMD SERVICES")
            for s, info in diff_data["added"].items():
                print(f"  + Service Added: {s} [State: {info['active']}, Enabled: {info['enabled']}]")
            for s, chg in diff_data["changed"].items():
                print(f"  ~ Service Changed: {s} ({chg['before']['active']} → {chg['after']['active']})")
            print()

    def summary_metrics(self, diff_data: dict) -> dict:
        total_mod = len(diff_data.get("added", {})) + len(diff_data.get("changed", {}))
        return {"Services Modified": total_mod}


class ProcessDetector(BaseDetector):
    name = "Process Activity"
    description = "Tracks process lifecycle, PPID, owner, and open file descriptors"

    def collect(self) -> dict:
        processes = {}
        out = run_cmd(["ps", "-eo", "pid,ppid,user,comm,args", "--no-headers"])
        for line in out.splitlines():
            parts = line.strip().split(None, 4)
            if len(parts) >= 4:
                pid, ppid, user, comm = parts[0], parts[1], parts[2], parts[3]
                fd_count = 0
                try:
                    fd_dir = Path(f"/proc/{pid}/fd")
                    if fd_dir.exists():
                        fd_count = len(list(fd_dir.iterdir()))
                except Exception:
                    pass
                processes[pid] = {"ppid": ppid, "user": user, "comm": comm, "fds": fd_count}
        return processes

    def diff(self, start: dict, stop: dict, meta_start: dict, meta_stop: dict) -> dict:
        comms_a = {v["comm"] for v in start.values()}
        started = {pid: v for pid, v in stop.items() if pid not in start and v["comm"] not in comms_a}
        return {"started": started}

    def render(self, diff_data: dict) -> None:
        if diff_data["started"]:
            print("PROCESS ACTIVITY")
            for pid, v in diff_data["started"].items():
                print(f"  + Process Started: {v['comm']} (PID {pid}, Owner: {v['user']}, Open FDs: {v['fds']})")
            print()

    def summary_metrics(self, diff_data: dict) -> dict:
        return {"Processes Started": len(diff_data.get("started", {}))}


class SocketDetector(BaseDetector):
    name = "Network Ports & Sockets"
    description = "Tracks active TCP/UDP listening ports and bound process names"

    def collect(self) -> dict:
        listeners = {}
        out = run_cmd(["ss", "-tulnp"])
        for line in out.splitlines():
            if line.startswith("Netid") or not line.strip():
                continue
            parts = line.split()
            if len(parts) >= 5:
                proto, addr = parts[0].upper(), parts[4]
                proc_match = re.search(r'users:\(\("([^"]+)"', line)
                proc_name = proc_match.group(1) if proc_match else "unknown"
                listeners[f"{proto} {addr}"] = {"proto": proto, "addr": addr, "process": proc_name}
        return listeners

    def diff(self, start: dict, stop: dict, meta_start: dict, meta_stop: dict) -> dict:
        return {"added": {k: stop[k] for k in stop if k not in start}}

    def render(self, diff_data: dict) -> None:
        if diff_data["added"]:
            print("NETWORK PORTS & SOCKETS")
            for k, v in diff_data["added"].items():
                print(f"  + Listening Port: {v['proto']} {v['addr']} → Process: {v['process']}")
            print()

    def summary_metrics(self, diff_data: dict) -> dict:
        return {"Ports Opened": len(diff_data.get("added", {}))}


class FilesystemDetector(BaseDetector):
    name = "Filesystem Integrity Watcher"
    description = "Recursively tracks content, permissions (mode), and ownership across watched directories"

    def collect(self) -> dict:
        files = {}
        watch_dirs = load_watch_dirs()
        ignore_patterns = load_ignore_patterns()

        def is_ignored(fp_str: str, fname: str) -> bool:
            return any(
                fnmatch.fnmatch(fp_str, pat) or fnmatch.fnmatch(fname, pat)
                for pat in ignore_patterns
            )

        for target_dir in watch_dirs:
            path_obj = Path(target_dir)
            if not path_obj.exists():
                continue
            for root, _, filenames in os.walk(path_obj):
                for fname in filenames:
                    filepath = Path(root) / fname
                    fp_str = str(filepath)
                    if is_ignored(fp_str, fname):
                        continue
                    try:
                        stat = filepath.stat()
                        files[fp_str] = {
                            "mtime": stat.st_mtime,
                            "size": stat.st_size,
                            "mode": oct(stat.st_mode & 0o7777),  # Octal permission bits (incl. setuid/setgid)
                            "uid": stat.st_uid,
                            "gid": stat.st_gid,
                            "sha256": hash_file(filepath)
                        }
                    except (PermissionError, FileNotFoundError):
                        continue
        return files

    def diff(self, start: dict, stop: dict, meta_start: dict, meta_stop: dict) -> dict:
        created, modified, perm_changed, deleted, suid_sgid_alerts = [], [], [], [], []

        for path, info_b in stop.items():
            if path not in start:
                created.append(path)
                if mode_has_suid_sgid(info_b.get("mode", "")):
                    suid_sgid_alerts.append({
                        "path": path,
                        "mode_a": None,
                        "mode_b": info_b.get("mode", ""),
                        "reason": "new file created with setuid/setgid bit set"
                    })
            else:
                info_a = start[path]
                mode_a, mode_b = info_a.get("mode", ""), info_b.get("mode", "")

                # Track mode (chmod) or ownership (chown/chgrp) updates
                if (mode_a != mode_b or
                    info_a.get("uid") != info_b.get("uid") or
                    info_a.get("gid") != info_b.get("gid")):
                    perm_changed.append({
                        "path": path,
                        "mode_a": mode_a,
                        "mode_b": mode_b
                    })
                    if mode_has_suid_sgid(mode_b) and not mode_has_suid_sgid(mode_a):
                        suid_sgid_alerts.append({
                            "path": path,
                            "mode_a": mode_a,
                            "mode_b": mode_b,
                            "reason": "setuid/setgid bit added"
                        })

                # Track file content/data updates
                if info_a.get("sha256") and info_b.get("sha256"):
                    if info_a["sha256"] != info_b["sha256"]:
                        modified.append(path)
                elif info_a["mtime"] != info_b["mtime"] or info_a["size"] != info_b["size"]:
                    modified.append(path)

        for path in start:
            if path not in stop:
                deleted.append(path)

        return {
            "created": created,
            "modified": modified,
            "perm_changed": perm_changed,
            "deleted": deleted,
            "suid_sgid_alerts": suid_sgid_alerts
        }

    def render(self, diff_data: dict) -> None:
        if (diff_data["created"] or diff_data["modified"] or diff_data["perm_changed"]
                or diff_data["deleted"] or diff_data["suid_sgid_alerts"]):
            print("FILESYSTEM UPDATES")
            for item in diff_data["suid_sgid_alerts"][:10]:
                before = item["mode_a"] if item["mode_a"] else "—"
                print(f"  ! ALERT: setuid/setgid bit set on {item['path']} ({before} → {item['mode_b']})")
            for f in diff_data["created"][:10]:
                print(f"  + Created:     {f}")
            for f in diff_data["modified"][:10]:
                print(f"  ~ Content Mod: {f}")
            for item in diff_data["perm_changed"][:10]:
                print(f"  ! Mode/Perms:  {item['path']} ({item['mode_a']} → {item['mode_b']})")
            for f in diff_data["deleted"][:10]:
                print(f"  - Deleted:     {f}")

            total = (len(diff_data['created']) + len(diff_data['modified']) + 
                     len(diff_data['perm_changed']) + len(diff_data['deleted']))
            if total > 30:
                print(f"  ... and {total - 30} additional file modifications")
            print()

    def summary_metrics(self, diff_data: dict) -> dict:
        total = (len(diff_data.get("created", [])) + 
                 len(diff_data.get("modified", [])) + 
                 len(diff_data.get("perm_changed", [])) + 
                 len(diff_data.get("deleted", [])))
        return {
            "Files Changed": total,
            "SUID/SGID Alerts": len(diff_data.get("suid_sgid_alerts", []))
        }


class JournalDetector(BaseDetector):
    name = "System Journal Errors"
    description = "Extracts journalctl warning/error logs generated during execution window"

    def collect(self) -> dict:
        return {}

    def diff(self, start: dict, stop: dict, meta_start: dict, meta_stop: dict) -> dict:
        s_dt = datetime.fromtimestamp(meta_start.get("timestamp", time.time())).strftime("%Y-%m-%d %H:%M:%S")
        e_dt = datetime.fromtimestamp(meta_stop.get("timestamp", time.time())).strftime("%Y-%m-%d %H:%M:%S")
        cmd = ["journalctl", f"--since={s_dt}", f"--until={e_dt}", "-p", "3..4", "--no-pager", "-n", "10"]
        out = run_cmd(cmd)
        return {"logs": out.splitlines() if out else []}

    def render(self, diff_data: dict) -> None:
        if diff_data["logs"]:
            print("SYSTEM JOURNAL ACTIVITY (WARNINGS & ERRORS)")
            for line in diff_data["logs"]:
                print(f"  > {line}")
            print()

    def has_changes(self, diff_data: dict) -> bool:
        # Journal lines are informational context, not a system change in
        # themselves — don't let them trip --fail-on-change on their own.
        return False


class MySQLDetector(BaseDetector):
    name = "MySQL Databases"
    description = "Tracks newly created or dropped MySQL/MariaDB databases"

    def collect(self) -> dict:
        # 1. State collection
        out = run_cmd(["mysql", "-e", "SHOW DATABASES;"])
        return {"databases": out.splitlines()}

    def diff(self, start: dict, stop: dict, meta_start: dict, meta_stop: dict) -> dict:
        # 2. State comparison
        d_a, d_b = set(start.get("databases", [])), set(stop.get("databases", []))
        return {"created": list(d_b - d_a), "dropped": list(d_a - d_b)}

    def render(self, diff_data: dict) -> None:
        # 3. Report output rendering
        if diff_data["created"] or diff_data["dropped"]:
            print("MYSQL DATABASE CHANGES")
            for db in diff_data["created"]:
                print(f"  + Database Created: {db}")
            for db in diff_data["dropped"]:
                print(f"  - Database Dropped: {db}")
            print()

    def summary_metrics(self, diff_data: dict) -> dict:
        # 4. Final summary box metric
        return {"Databases Created": len(diff_data.get("created", []))}

