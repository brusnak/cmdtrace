class ExecutionEnvDetector(BaseDetector):
    name = "Execution Environment"
    description = "Tracks PATH, environment variables, and shell profile hashes"

    def collect(self) -> dict:
        env_files = ["/etc/profile", "/etc/environment", "/etc/bash.bashrc", str(Path.home() / ".bashrc")]
        return {
            "path": os.environ.get("PATH", ""),
            # Values are redacted by name pattern (KEY/TOKEN/SECRET/PASSWORD/etc.)
            # before ever being written to a snapshot, report, or export file.
            "env_vars": redact_env(dict(os.environ)),
            "profile_hashes": {f: hash_file(Path(f)) for f in env_files if Path(f).exists()}
        }

    def diff(self, start: dict, stop: dict, meta_start: dict, meta_stop: dict) -> dict:
        env_a, env_b = start.get("env_vars", {}), stop.get("env_vars", {})
        sensitive_a = {k for k in env_a if SENSITIVE_ENV_NAME_PATTERN.search(k)}
        sensitive_b = {k for k in env_b if SENSITIVE_ENV_NAME_PATTERN.search(k)}

        return {
            "path_changed": start.get("path") != stop.get("path"),
            "profiles_changed": start.get("profile_hashes") != stop.get("profile_hashes"),
            "sensitive_vars_added": sorted(sensitive_b - sensitive_a),
            "sensitive_vars_removed": sorted(sensitive_a - sensitive_b),
            "sensitive_vars_changed": sorted(
                k for k in sensitive_a & sensitive_b if env_a.get(k) != env_b.get(k)
            )
        }

    def render(self, diff_data: dict) -> None:
        if (diff_data["path_changed"] or diff_data["profiles_changed"]
                or diff_data["sensitive_vars_added"] or diff_data["sensitive_vars_removed"]
                or diff_data["sensitive_vars_changed"]):
            print("ENVIRONMENT CONFIGURATION")
