def build_report(meta_start: dict, start_subsystems: dict, meta_stop: dict, stop_subsystems: dict,
                  detectors: list, report_title: str = "CMDTRACE MASTER CHANGE REPORT",
                  filesystem_events: list = None) -> tuple:
    """
    Diff and render every detector, producing both the human-readable report
    text and a JSON-serializable equivalent. Returns
    (report_text, report_json, any_changes).
    """
    duration = timedelta(seconds=int(meta_stop["timestamp"] - meta_start.get("timestamp", meta_stop["timestamp"])))

    summary_accumulator = {}
    json_subsystems = {}
    any_changes = False

    report_buffer = io.StringIO()
    with contextlib.redirect_stdout(report_buffer):
        print("================================================================================")
        print(f"{report_title:^80}")
        print("================================================================================")
        print(f"Generated:      {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
        print(f"Trace Duration: {duration}\n")

        for d in detectors:
            key = d.detector_key()
            d_start = start_subsystems.get(key, {})
            d_stop = stop_subsystems.get(key, {})

            diff_data = d.diff(d_start, d_stop, meta_start, meta_stop)
            d.render(diff_data)

            metrics = d.summary_metrics(diff_data)
            summary_accumulator.update(metrics)
            json_subsystems[key] = diff_data

            if d.has_changes(diff_data):
                any_changes = True

        if filesystem_events:
            render_filesystem_activity(filesystem_events)
            summary_accumulator.update(filesystem_activity_metrics(filesystem_events))
            json_subsystems["FilesystemActivity"] = {"events": filesystem_events}
            any_changes = True

        print("================================================================================")
        print("SUMMARY")
        for metric_name, value in summary_accumulator.items():
            print(f"  {metric_name:<22}: {value}")
        print("================================================================================")

    report_text = report_buffer.getvalue()
    report_json = {
        "generated": datetime.now().isoformat(),
        "trace_duration_seconds": int(duration.total_seconds()),
        "any_changes": any_changes,
        "summary": summary_accumulator,
        "subsystems": json_subsystems
    }
    return report_text, report_json, any_changes


def export_report_if_requested(report_text: str, report_json: dict, export_arg: str, export_format: str) -> None:
    """Shared export step used by stop/run/compare: write to disk and report the path(s)."""
    if not export_arg:
        return
    try:
        for path in write_report(report_text, report_json, export_arg, export_format):
            print(f"Report exported to: {path}")
    except Exception as e:
        print(f"Error exporting report: {e}", file=sys.stderr)


def cmd_start(session: str = "default"):
    if os.geteuid() != 0:
        print("Notice: Running without root privileges. System inspection will be limited.\n")

    print(f"Capturing baseline system state across all registered detectors (session: {session})...")
    detectors = get_all_detectors()

    snapshot = {
        "_meta": {"timestamp": time.time(), "session": session},
        "subsystems": collect_all(detectors)
    }

    snapshot_file = get_snapshot_file(session)
    try:
        snapshot_file.parent.mkdir(parents=True, exist_ok=True)
        with open(snapshot_file, "w") as f:
            json.dump(snapshot, f)
        monitor_meta = start_event_collector(session)
        if monitor_meta:
            snapshot["_meta"]["event_collector"] = monitor_meta
            with open(snapshot_file, "w") as f:
                json.dump(snapshot, f)
            print(f"Baseline captured successfully at {datetime.now().strftime('%H:%M:%S')} ({len(detectors)} modules).")
            print("Filesystem activity timeline: active")
        else:
            print(f"Baseline captured successfully at {datetime.now().strftime('%H:%M:%S')} ({len(detectors)} modules).")
            print("Warning: filesystem activity timeline is unavailable; snapshot diff remains active.", file=sys.stderr)
    except Exception as e:
        print(f"Error saving snapshot: {e}", file=sys.stderr)
        sys.exit(1)


def cmd_stop(session: str = "default", export_arg: str = None, export_format: str = "text",
             fail_on_change: bool = False, no_history: bool = False):
    snapshot_file = get_snapshot_file(session)
    if not snapshot_file.exists():
        print(f"Error: No active cmdtrace session '{session}' found. Run 'cmdtrace start "
              f"{'--session ' + session if session != 'default' else ''}' first.", file=sys.stderr)
        sys.exit(1)

    print("Capturing ending system state and comparing...")
    try:
        with open(snapshot_file, "r") as f:
            start_snapshot = json.load(f)
    except Exception as e:
        print(f"Error loading snapshot: {e}", file=sys.stderr)
        sys.exit(1)

    filesystem_events = stop_event_collector(start_snapshot.get("_meta", {}).get("event_collector", {}))
    meta_stop = {"timestamp": time.time()}
    detectors = get_all_detectors()
    stop_subsystems = collect_all(detectors)

    meta_start = start_snapshot.get("_meta", {})
    start_subsystems = start_snapshot.get("subsystems", {})

    report_text, report_json, any_changes = build_report(
        meta_start, start_subsystems, meta_stop, stop_subsystems, detectors,
        filesystem_events=filesystem_events
    )
    print(report_text)

    export_report_if_requested(report_text, report_json, export_arg, export_format)

    if not no_history:
        append_history(session, meta_start, meta_stop, report_json["summary"])

    try:
        snapshot_file.unlink()
    except Exception:
        pass

    if fail_on_change and any_changes:
        sys.exit(2)


def cmd_run(command_args: list, session: str = "default", export_arg: str = None, export_format: str = "text",
            fail_on_change: bool = False, no_history: bool = False):
    print(f"Starting cmdtrace session for execution wrapper: {' '.join(command_args)}")
    cmd_start(session=session)
    print("\n--------------------------------------------------------------------------------")
    try:
        subprocess.run(command_args, check=False)
    except Exception as e:
        print(f"Command execution failed: {e}", file=sys.stderr)
    print("--------------------------------------------------------------------------------\n")
    cmd_stop(session=session, export_arg=export_arg, export_format=export_format,
              fail_on_change=fail_on_change, no_history=no_history)


def cmd_compare(name: str, export_arg: str = None, export_format: str = "text",
                 fail_on_change: bool = False, no_history: bool = False):
    baseline_file = get_baseline_file(name)
    if not baseline_file.exists():
        print(f"Error: baseline '{name}' not found. Run 'cmdtrace baseline save {name}' first.", file=sys.stderr)
        sys.exit(1)

    try:
        with open(baseline_file, "r") as f:
            baseline_snapshot = json.load(f)
    except Exception as e:
        print(f"Error loading baseline: {e}", file=sys.stderr)
        sys.exit(1)

    print(f"Capturing current system state and comparing against baseline '{name}'...")
    meta_stop = {"timestamp": time.time()}
    detectors = get_all_detectors()
    stop_subsystems = collect_all(detectors)

    meta_start = baseline_snapshot.get("_meta", {})
    start_subsystems = baseline_snapshot.get("subsystems", {})

    report_text, report_json, any_changes = build_report(
        meta_start, start_subsystems, meta_stop, stop_subsystems, detectors,
        report_title=f"CMDTRACE BASELINE COMPARISON: {name}"
    )
    print(report_text)

    export_report_if_requested(report_text, report_json, export_arg, export_format)

    if not no_history:
        append_history(f"baseline:{name}", meta_start, meta_stop, report_json["summary"])

    if fail_on_change and any_changes:
        sys.exit(2)


def _add_export_and_gate_args(subparser):
    """Shared --export/--export-format/--fail-on-change/--no-history flags for stop/run/compare."""
    subparser.add_argument(
        "--export", "-e", metavar="PATH", default=None,
        help="Save the change report to PATH. If PATH is a directory, a timestamped "
             "report file is created inside it; otherwise PATH is used as the exact filename."
    )
    subparser.add_argument(
        "--export-format", choices=["text", "json", "both"], default="text",
        help="Format for --export output (default: text)."
    )
    subparser.add_argument(
        "--fail-on-change", action="store_true",
        help="Exit with status 2 if any detector reports a change (useful in CI/automation)."
    )
    subparser.add_argument(
        "--no-history", action="store_true",
        help="Skip appending a summary line to the persistent history log."
    )


def main():
    parser = argparse.ArgumentParser(
        description="cmdtrace — Modular Linux System Change Tracking Tool",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    subparsers = parser.add_subparsers(dest="command", required=False)

    start_parser = subparsers.add_parser("start", help="Capture baseline system state")
    start_parser.add_argument(
        "--session", "-s", metavar="NAME", default="default",
        help="Named session, allowing multiple concurrent traces (default: 'default')."
    )

    stop_parser = subparsers.add_parser("stop", help="Capture ending state and generate change report")
    stop_parser.add_argument(
        "--session", "-s", metavar="NAME", default="default",
        help="Named session matching the one used with 'start' (default: 'default')."
    )
    _add_export_and_gate_args(stop_parser)

    subparsers.add_parser("help", help="Display full manual and active detector registry")

    run_parser = subparsers.add_parser("run", help="Run a command wrapped in automatic cmdtrace tracing")
    run_parser.add_argument(
        "--session", "-s", metavar="NAME", default="default",
        help="Named session, allowing multiple concurrent traces (default: 'default')."
    )
    _add_export_and_gate_args(run_parser)
    run_parser.add_argument("cmd_args", nargs=argparse.REMAINDER, help="Command and arguments to execute")

    subparsers.add_parser("sessions", help="List all currently active (started, not yet stopped) sessions")

    baseline_parser = subparsers.add_parser("baseline", help="Manage saved golden baselines for drift comparison")
    baseline_subparsers = baseline_parser.add_subparsers(dest="baseline_command", required=False)
    bl_save = baseline_subparsers.add_parser("save", help="Capture current state and store it as a named baseline")
    bl_save.add_argument("name", help="Name for this baseline")
    baseline_subparsers.add_parser("list", help="List all saved baselines")
    bl_rm = baseline_subparsers.add_parser("remove", help="Delete a saved baseline")
    bl_rm.add_argument("name", help="Name of the baseline to remove")

    compare_parser = subparsers.add_parser("compare", help="Diff current live state against a saved baseline")
    compare_parser.add_argument("name", help="Name of the baseline to compare against")
    _add_export_and_gate_args(compare_parser)

    watch_parser = subparsers.add_parser("watch", help="Manage dynamic filesystem watch directories")
    watch_subparsers = watch_parser.add_subparsers(dest="watch_command", required=False)
    watch_subparsers.add_parser("list", help="List all currently watched directories")

    add_p = watch_subparsers.add_parser("add", help="Add a directory to the watch list")
    add_p.add_argument("path", help="Directory path to watch")

    rm_p = watch_subparsers.add_parser("remove", help="Remove a directory from the watch list")
    rm_p.add_argument("path", help="Directory path to remove")

    ignore_parser = watch_subparsers.add_parser("ignore", help="Manage filesystem watcher ignore patterns")
    ignore_subparsers = ignore_parser.add_subparsers(dest="ignore_command", required=False)
    ignore_subparsers.add_parser("list", help="List all currently ignored glob patterns")
    ig_add = ignore_subparsers.add_parser("add", help="Add a glob pattern to the ignore list")
    ig_add.add_argument("pattern", help="Glob pattern, e.g. '*.log' or '*/tmp/*'")
    ig_rm = ignore_subparsers.add_parser("remove", help="Remove a glob pattern from the ignore list")
    ig_rm.add_argument("pattern", help="Glob pattern to remove")

    set_parser = subparsers.add_parser("set", help="Set persistent cmdtrace configuration")
    set_subparsers = set_parser.add_subparsers(dest="set_command", required=False)
    set_module_parser = set_subparsers.add_parser("module", help="Configure external detector modules")
    set_module_subparsers = set_module_parser.add_subparsers(dest="module_command", required=False)
    set_module_path_parser = set_module_subparsers.add_parser("path", help="Set the external detector module directory")
    set_module_path_parser.add_argument("path", help="Directory containing external cmdtrace detector .py modules")

    subparsers.add_parser("modules", help="List built-in and loaded external detector modules")

    # Internal command used by start to keep the monitor alive after start exits.
    collector_parser = subparsers.add_parser("_collector", help=argparse.SUPPRESS)
    collector_parser.add_argument("--backend", choices=["python-inotify"], required=True)
    collector_parser.add_argument("--session", required=True)
    collector_parser.add_argument("--event-file", required=True)

    args = parser.parse_args()

    if args.command == "set":
        if args.set_command == "module" and args.module_command == "path":
            cmd_set_module_path(args.path)
        else:
            parser.error("usage: cmdtrace set module path <directory>")
    elif args.command == "modules":
        cmd_modules_list()
    elif args.command == "_collector":
        if args.backend == "python-inotify":
            sys.exit(_run_inotify_collector(Path(args.event_file)))
        print(f"Unsupported collector backend: {args.backend}", file=sys.stderr)
        sys.exit(1)
    elif args.command == "start":
        cmd_start(session=args.session)
    elif args.command == "stop":
        cmd_stop(session=args.session, export_arg=args.export, export_format=args.export_format,
                  fail_on_change=args.fail_on_change, no_history=args.no_history)
    elif args.command == "run":
        if not args.cmd_args:
            print("Error: No command provided for 'cmdtrace run'. Example: cmdtrace run -- apt install nginx")
            sys.exit(1)
        target_cmd = args.cmd_args[1:] if args.cmd_args[0] == "--" else args.cmd_args
        cmd_run(target_cmd, session=args.session, export_arg=args.export, export_format=args.export_format,
                 fail_on_change=args.fail_on_change, no_history=args.no_history)
    elif args.command == "sessions":
        cmd_sessions_list()
    elif args.command == "baseline":
        if args.baseline_command == "save":
            cmd_baseline_save(args.name)
        elif args.baseline_command == "remove":
            cmd_baseline_remove(args.name)
        else:
            cmd_baseline_list()
    elif args.command == "compare":
        cmd_compare(args.name, export_arg=args.export, export_format=args.export_format,
                     fail_on_change=args.fail_on_change, no_history=args.no_history)
    elif args.command == "watch":
        if args.watch_command == "list":
            cmd_watch_list()
        elif args.watch_command == "add":
            cmd_watch_add(args.path)
        elif args.watch_command == "remove":
            cmd_watch_remove(args.path)
        elif args.watch_command == "ignore":
            if args.ignore_command == "add":
                cmd_ignore_add(args.pattern)
            elif args.ignore_command == "remove":
                cmd_ignore_remove(args.pattern)
            else:
                cmd_ignore_list()
        else:
            cmd_watch_list()
    elif args.command == "help" or len(sys.argv) == 1:
        cmd_help()


if __name__ == "__main__":
    main()