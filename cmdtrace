def resolve_export_paths(export_arg: str, export_format: str) -> dict:
    """
    Determine the file path(s) a report should be written to, keyed by
    format ('text' and/or 'json').

    Directory mode (export_arg names an existing directory, or ends in a
    path separator): a timestamped base filename is generated inside it,
    e.g. cmdtrace_report_20260101_120000.txt / .json.

    Exact-filename mode (export_arg names a specific file):
      - format 'text' or 'json': written exactly to that path, as given.
      - format 'both': the path's extension (if any) is stripped and used
        as a base, with '.txt' and '.json' appended, e.g.
        'out' or 'out.txt' -> out.txt and out.json.
    """
    target = Path(export_arg).expanduser()
    looks_like_dir = export_arg.endswith(("/", os.sep)) or target.is_dir()
    paths = {}

    if looks_like_dir:
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        base = target / f"cmdtrace_report_{timestamp}"
        if export_format in ("text", "both"):
            paths["text"] = base.with_suffix(".txt")
        if export_format in ("json", "both"):
            paths["json"] = base.with_suffix(".json")
    else:
        if export_format == "both":
            base = target.with_suffix("")
            paths["text"] = base.with_suffix(".txt")
            paths["json"] = base.with_suffix(".json")
        elif export_format == "text":
            paths["text"] = target
        elif export_format == "json":
            paths["json"] = target

    return {fmt: p.resolve() for fmt, p in paths.items()}


def write_report(report_text: str, report_json: dict, export_arg: str, export_format: str) -> list:
    """Write the report to disk in the requested format(s). Returns the paths written."""
    paths = resolve_export_paths(export_arg, export_format)
    written = []
    for fmt, path in paths.items():
        path.parent.mkdir(parents=True, exist_ok=True)
        with open(path, "w") as f:
            if fmt == "text":
                f.write(report_text)
            else:
                json.dump(report_json, f, indent=2, default=str)
        written.append(path)
    return written


