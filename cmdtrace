SYSTEM_LOG_FILE = Path("/var/log/cmdtrace/history.log")
USER_LOG_FILE = Path.home() / ".local/state/cmdtrace/history.log"

def append_history(session_label: str, meta_start: dict, meta_stop: dict, summary: dict) -> None:
    """Append a summary to system log, falling back to user home directory on permission error."""
    duration = timedelta(seconds=int(meta_stop["timestamp"] - meta_start.get("timestamp", meta_stop["timestamp"])))
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    metrics_str = ", ".join(f"{k}={v}" for k, v in summary.items())
    log_line = f"{ts} | session={session_label} | duration={duration} | {metrics_str}\n"

    # Attempt primary system log first, then fallback to user home directory
    for target_path in (SYSTEM_LOG_FILE, USER_LOG_FILE):
        try:
            target_path.parent.mkdir(parents=True, exist_ok=True)
            with open(target_path, "a") as f:
                f.write(log_line)
            return  # Successfully written
        except PermissionError:
            continue  # Fall through to USER_LOG_FILE
        except Exception as e:
            print(f"Warning: could not write to history log ({target_path}): {e}", file=sys.stderr)
            break

