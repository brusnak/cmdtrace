def get_snapshot_file(session: str) -> Path:
    """Resolve the on-disk snapshot path for a given session name."""
    if session == "default":
        return SNAPSHOT_FILE
    safe = re.sub(r'[^A-Za-z0-9_.-]', '_', session)
    return SNAPSHOT_FILE.parent / f"cmdtrace_snapshot_{safe}.json"


def get_baseline_file(name: str) -> Path:
    """Resolve the on-disk path for a named baseline."""
    safe = re.sub(r'[^A-Za-z0-9_.-]', '_', name)
    return BASELINE_DIR / f"{safe}.json"


def cmd_sessions_list():
    """List all currently active (started but not yet stopped) sessions."""
    pattern = str(SNAPSHOT_FILE.parent / "cmdtrace_snapshot*.json")
    files = sorted(glob.glob(pattern))
    if not files:
        print("No active cmdtrace sessions.")
        return

    print("ACTIVE CMDTRACE SESSIONS:")
    for f in files:
        p = Path(f)
        session_name = "default" if p.name == SNAPSHOT_FILE.name else p.stem.replace("cmdtrace_snapshot_", "", 1)
        try:
            with open(p) as fh:
                meta = json.load(fh).get("_meta", {})
            started = datetime.fromtimestamp(meta.get("timestamp", 0)).strftime("%Y-%m-%d %H:%M:%S")
        except Exception:
            started = "unknown"
        print(f"  • {session_name:<20} started {started}  ({p})")


def cmd_baseline_save(name: str):
    """Capture the current full system state and store it as a named baseline."""
    print(f"Capturing current system state as baseline '{name}'...")
    detectors = get_all_detectors()
    snapshot = {
        "_meta": {"timestamp": time.time(), "label": name},
        "subsystems": collect_all(detectors)
    }
    baseline_file = get_baseline_file(name)
    try:
        baseline_file.parent.mkdir(parents=True, exist_ok=True)
        with open(baseline_file, "w") as f:
            json.dump(snapshot, f)
        print(f"Baseline '{name}' saved to {baseline_file}")
    except Exception as e:
        print(f"Error saving baseline: {e}", file=sys.stderr)
        sys.exit(1)


def cmd_baseline_list():
    """List all saved baselines."""
    files = sorted(BASELINE_DIR.glob("*.json")) if BASELINE_DIR.exists() else []
    if not files:
        print("No baselines saved yet. Use 'cmdtrace baseline save <name>' to create one.")
        return

    print("SAVED BASELINES:")
    for f in files:
        try:
            with open(f) as fh:
                meta = json.load(fh).get("_meta", {})
            ts = datetime.fromtimestamp(meta.get("timestamp", 0)).strftime("%Y-%m-%d %H:%M:%S")
        except Exception:
