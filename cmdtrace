# ABSTRACT BASE DETECTOR (MODULAR INTERFACE)
# ==============================================================================

class BaseDetector(ABC):
    """
    Abstract Base Class for all cmdtrace subsystem monitors.

    External modules should subclass this class and provide at least `name`,
    `description`, `collect()`, `diff()`, and `render()`. An optional `key`
    may be supplied to give the detector a stable snapshot/report identifier.
    """
    name: str = "Base Detector"
    description: str = "Base detector description"
    key: Optional[str] = None

    @abstractmethod
    def collect(self) -> dict:
        """Capture live system state into a JSON-serializable dictionary."""
        pass

    @abstractmethod
    def diff(self, start_data: dict, stop_data: dict, meta_start: dict, meta_stop: dict) -> dict:
        """Compute differences between baseline and ending state."""
        pass

    @abstractmethod
    def render(self, diff_data: dict) -> None:
        """Print human-readable change details to stdout if modifications exist."""
        pass

    def summary_metrics(self, diff_data: dict) -> dict:
        """Return key-value pair metrics to be printed in the final summary box."""
        return {}

    def has_changes(self, diff_data: dict) -> bool:
        """
        Return True if this detector's diff indicates an actual system change.
        Used by --fail-on-change. Default: any truthy value in the diff dict
        counts as a change. Override for detectors whose diff is purely
        informational (e.g. journal log excerpts) and shouldn't trip it.
        """
        if isinstance(diff_data, dict):
            return any(bool(v) for v in diff_data.values())
        return bool(diff_data)

    def detector_key(self) -> str:
        """Return the stable key used for snapshot and report storage."""
        if self.key:
            return self.key
        if self.__class__ in _BUILTIN_DETECTOR_CLASSES:
            return self.__class__.__name__
        return f"external:{self.__class__.__module__}.{self.__class__.__name__}"

    def get_help_text(self) -> str:
        """Return formatted string entry for 'cmdtrace help'."""
        return f"  • {self.name:<28} {self.description}"


def load_external_detector_modules() -> None:
    """Load optional detector modules from the configured module directory.

    Built-in detectors remain defined in this script and are never replaced by
    external modules. External modules are loaded alphabetically and only once
    per cmdtrace process. A bad optional module is reported but does not prevent
    the built-in detector set from running.
    """
    global _EXTERNAL_MODULES_LOADED, _EXTERNAL_MODULE_FILES, _EXTERNAL_MODULE_ERRORS
    if _EXTERNAL_MODULES_LOADED:
        return
    _EXTERNAL_MODULES_LOADED = True

    module_path = load_module_path()
    if module_path is None or not module_path.is_dir():
        return

    # When cmdtrace is executed directly, Python calls this module __main__.
    # External modules use `from cmdtrace import BaseDetector`; aliasing the
    # running module prevents Python from loading a second cmdtrace instance.
    sys.modules.setdefault("cmdtrace", sys.modules[__name__])

    import importlib.util

    for module_file in sorted(module_path.glob("*.py")):
        if module_file.name.startswith("_"):
            continue

        module_name = f"cmdtrace_external_{module_file.stem}"
        try:
            spec = importlib.util.spec_from_file_location(module_name, module_file)
            if spec is None or spec.loader is None:
                raise ImportError("could not create import specification")
            module = importlib.util.module_from_spec(spec)
            sys.modules[module_name] = module
            spec.loader.exec_module(module)
            _EXTERNAL_MODULE_FILES.append(str(module_file))
        except Exception as exc:
            _EXTERNAL_MODULE_ERRORS.append({"file": str(module_file), "error": str(exc)})
            print(f"Warning: external detector module '{module_file}' failed to load: {exc}", file=sys.stderr)


def get_all_detectors() -> list:
    """Return built-in detectors first, followed by optional external detectors."""
    load_external_detector_modules()
    classes = list(_BUILTIN_DETECTOR_CLASSES)
    builtin_ids = {id(cls) for cls in classes}
    for cls in BaseDetector.__subclasses__():
        if id(cls) not in builtin_ids:
            classes.append(cls)
    return [cls() for cls in classes]


def collect_all(detectors: list) -> dict:
    """Run every detector's collect() concurrently and return {ClassName: data}."""
    results = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(len(detectors), 1)) as executor:
        future_map = {executor.submit(d.collect): d.detector_key() for d in detectors}
        for future in concurrent.futures.as_completed(future_map):
            name = future_map[future]
            try:
                results[name] = future.result()
            except Exception as e:
                print(f"Warning: detector '{name}' failed to collect: {e}", file=sys.stderr)
                results[name] = {}
    return results


