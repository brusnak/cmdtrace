                print("  ~ Environment PATH variable modified")
            if diff_data["profiles_changed"]:
                print("  ~ System/User shell profile scripts modified")
            for v in diff_data["sensitive_vars_changed"]:
                print(f"  ! ALERT: Sensitive environment variable value changed: {v}")
            for v in diff_data["sensitive_vars_added"]:
                print(f"  ! ALERT: New sensitive environment variable set: {v}")
            for v in diff_data["sensitive_vars_removed"]:
                print(f"  ! ALERT: Sensitive environment variable removed: {v}")
            print()

    def summary_metrics(self, diff_data: dict) -> dict:
        total = (len(diff_data.get("sensitive_vars_added", []))
                 + len(diff_data.get("sensitive_vars_removed", []))
                 + len(diff_data.get("sensitive_vars_changed", [])))
        return {"Sensitive Env Var Changes": total}


